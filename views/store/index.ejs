<%- include('../partials/head') %>
</head>
  <body>
    <%- include ('../partials/header') %>
    
      <main class="container mx-auto p-8 mt-10">
        <% if (registeredHomes.length === 0) { %>
          <h2 class="text-5xl text-gray-800 font-bold text-center mb-10">
            Welcome to airbnb index
          </h2>
          <div class="text-center text-gray-600 text-lg">
            No homes registered yet.
          </div>
        <% } else { %>
          <h2 class="text-5xl text-red-500 font-bold text-center mb-10">
            Here are our registered homes index
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% registeredHomes.forEach(home => { %>
            <div class="bg-white shadow-lg rounded-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
              <% if(home.photo) { %>
                <img src="<%= home.photo %>" alt="<%= home.homeName %>" class="w-full h-48 object-cover">
              <% } else { %>
                <div class="w-full h-48 bg-gray-200 flex items-center justify-center">
                  <span class="text-gray-400">No Photo</span>
                </div>
              <% } %>
              <div class="p-4">
                <h3 class="text-xl font-bold text-gray-800 mb-2"><%= home.homeName %></h3>
                <div class="space-y-2 text-gray-600">
                  <p class="flex items-center">
                    <span class="font-semibold mr-2">Price:</span>
                    Rs: <%= home.price %>/night
                  </p>
                  <p class="flex items-center">
                    <span class="font-semibold mr-2">Location:</span>
                    <%= home.location %>
                  </p>
                  <p class="flex items-center">
                    <span class="font-semibold mr-2">Rating:</span>
                    <span class="text-yellow-500">★</span> <%= home.rating %>/5
                  </p>
                  <button class="bg-green-300 p-2">Book</button>
                </div>
              </div>
            </div>
         <% }) %>
          </div>
        <% } %>
      </main>
  </body>
</html>
